# ---- Interpreter: turns free-form chat into world actions + a reply (LFM2 is too small for this)
OPENAI_API_KEY=
INTERPRETER_MODEL=gpt-5-mini

# ---- Liquid LFM2 via local Ollama (OpenAI-compatible). Start with: ollama serve
#      Model pulled with: ollama pull hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q8_0
LIQUID_API_KEY=ollama
LIQUID_BASE_URL=http://localhost:11434/v1
LIQUID_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q8_0

# ---- Black Forest Labs FLUX (text -> image, selfie -> character via Kontext, video). Header: x-key
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai/v1
BFL_MODEL=flux-2-pro

# ---- Nimble: live web signals into the world (weather -> sky/rain, headline -> billboard)
NIMBLE_API_KEY=
LIVE_INTERVAL_MS=300000
# LIVE_WEATHER_URL=   LIVE_NEWS_URL=   (defaults: NWS San Francisco forecast, Hacker News front page)

# ---- Image -> 3D. Default: fal.ai hosted Hunyuan3D-2 (plug and play, needs FAL_KEY from https://fal.ai/dashboard/keys)
MESH_PROVIDER=fal
FAL_KEY=
FAL_3D_MODEL=fal-ai/hunyuan3d/v2
FAL_3D_MODEL_FALLBACK=fal-ai/hunyuan-3d/v3.1/rapid/image-to-3d
# Fallback: MESH_PROVIDER=local -> teammate's Hunyuan3D-2 api_server.py (LAN IP)
HUNYUAN_URL=http://localhost:8081

# ---- Rawtree (event analytics; https://rawtree.com/docs/quickstart/api). Key starts with rt_
RAWTREE_API_KEY=
RAWTREE_URL=https://api.rawtree.com
RAWTREE_TABLE=horizoncraft_events
