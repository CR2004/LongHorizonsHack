DESCRIPTION >
    Latest events (feed + GC decisions) for the memory panel.

NODE recent
SQL >
    %
    SELECT ts, run_id, world, type, payload, tokens
    FROM events
    WHERE 1
    {% if defined(run_id) %} AND run_id = {{String(run_id)}} {% end %}
    {% if defined(type) %} AND type = {{String(type)}} {% end %}
    ORDER BY ts DESC
    LIMIT {{Int32(limit, 50)}}

TYPE endpoint
