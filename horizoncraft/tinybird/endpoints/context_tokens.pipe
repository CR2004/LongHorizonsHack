DESCRIPTION >
    Prompt/context size over time (events that carry tokens > 0), per 10s bucket.

NODE context
SQL >
    %
    SELECT toStartOfInterval(ts, INTERVAL 10 SECOND) AS t, max(tokens) AS tokens
    FROM events
    WHERE tokens > 0 {% if defined(run_id) %} AND run_id = {{String(run_id)}} {% end %}
    GROUP BY t
    ORDER BY t DESC
    LIMIT {{Int32(limit, 360)}}

TYPE endpoint
