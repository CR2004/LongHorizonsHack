DESCRIPTION >
    Every HorizonCraft action, world switch, and memory decision.

SCHEMA >
    `ts` DateTime64(3) `json:$.ts`,
    `run_id` String `json:$.run_id`,
    `world` LowCardinality(String) `json:$.world`,
    `type` LowCardinality(String) `json:$.type`,
    `payload` String `json:$.payload`,
    `tokens` UInt32 `json:$.tokens`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(ts)"
ENGINE_SORTING_KEY "run_id, ts"
